{
  "schemaVersion": 1,
  "id": "${modId}",
  "version": "${version}",
  "name": "${modName}",
  "description": "${modDescription}",
  "authors": [
    "${authors}"
  ],
  "contributors": [
    "${contributors}"
  ],
  "contact": {
    "homepage": "${homepage}",
    "issues": "${issues}",
    "sources": "${sources}"
  },
  "license": "${license}",
  "icon": "assets/${modId}/icon.png",
  "mixins": [
    "${modId}.mixins.json"
  ],
  "accessWidener": "${modId}.accesswidener",
  "depends": {
    "minecraft": ">=${mc}",
    "fabricloader": ">=${fl}",
    "fabric-api": ">=${fapi}",
    "switchy-core": ">=${switchy}",
    "switchy-client": ">=${switchy}",
    "switchy-ui": ">=${switchy}",
    "switchy-compat": ">=${switchy}",
    "styledchat": ">=${styledChat}"
  },
  "entrypoints": {
    "switchy": [
      "folk.sisby.switchy_proxy.SwitchyProxy",
      "folk.sisby.switchy_proxy.modules.ProxyModule"
    ],
    "switchy_client": [
      "folk.sisby.switchy_proxy.modules.client.ProxyClientModule"
    ]
  }
}
